{
  "name": "picode",
  "version": "0.4.0",
  "description": "Model-agnostic AI coding agent built on the OpenAI Responses API",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qsrahman/picode.git"
  },
  "homepage": "https://github.com/qsrahman/picode#readme",
  "bugs": {
    "url": "https://github.com/qsrahman/picode/issues"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "picode": "src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "node --env-file=.env src/index.ts",
    "dev": "node --watch --env-file=.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "python3 scripts/live-e2e.py",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ansis": "^4.3.1",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
