# Copy to .env and fill in. pcode loads .env from the working directory at
# startup; variables already exported in your shell take precedence.
OPENAI_API_KEY=sk-your-key-here

# Optional: default model used when --model is not given.
# OPENAI_DEFAULT_MODEL=gpt-5.6

# Optional: point pcode at any OpenAI-compatible endpoint. Overrides the
# baseURL in pcode.json when set.
# OPENAI_BASE_URL=https://api.openai.com/v1
